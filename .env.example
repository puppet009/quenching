# 复制为 .env 后按本地环境修改。docker-compose 与各服务默认值已可直接本地跑通。

# ---- PostgreSQL（平台业务库）----
DB_DSN=postgres://quenching:quenching@localhost:5432/quenching?sslmode=disable

# ---- Redis ----
REDIS_ADDR=localhost:6379

# 平台侧不使用 Elasticsearch：结构化操作写 PostgreSQL（session_operations），
# 应用日志走 Loki（T1-16/17）。沙箱内电商自带的 ES 由模板 Chart 编排，无需此处配置。

# ---- RabbitMQ（事件总线）----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ---- LLM（ai-service）----
# MVP 默认开启 MOCK，不调用真实模型、不产生费用；接入时设 LLM_MOCK=false 并填 KEY。
# 模型：qwen3.8-flash，走阿里云 DashScope 的 OpenAI 兼容端点
# （代码会自动在 BASE_URL 后拼接 /v1/chat/completions）。
LLM_MOCK=true
LLM_PROVIDER=qwen
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
LLM_MODEL=qwen3.8-flash

# ---- 服务端口 ----
CONTENT_SERVICE_ADDR=:8082
AI_SERVICE_PORT=8000
