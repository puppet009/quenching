# api-gateway 环境变量样例（复制为 .env 后按需修改）
#
# 本地进程级联调（go run）无需设置本文件：默认路由表已指向 localhost
# 统一端口（user:8085 content:8082 training:8086 review:8087
# fault-engine:8088 sandbox:8089）。
# g7 起 WebSocket（/ws）与内部事件接口（/api/v1/events/publish|stats）已并入本进程 :8080，
# 不再有独立的 ws-gateway:8090；其余 /api/v1/events* 为 review-service 埋点接口，走代理。
#
# 云上部署通过 ROUTE_N 整表覆盖为 Kubernetes Service DNS。
# 规则格式：ROUTE_N=路径前缀|目标URL|是否鉴权(true/false)
# 注意：只要存在任意一条 ROUTE_N 即整表替换默认表；编号从 0 开始且必须连续；最多 64 条。

GATEWAY_ADDR=":8080"
JWT_SECRET="quenching-dev-secret"

# ---------- WebSocket（g7 并入） ----------
# WS 握手 Origin 白名单，逗号分隔；* 表示不校验
WS_ALLOW_ORIGINS="*"
# 内部事件发布接口（POST /api/v1/events/publish）的 X-Internal-API-Key
# 留空表示不校验（仅限本地开发）；云上必须设置
WS_INTERNAL_API_KEY=""

# ---------- CORS ----------
CORS_ENABLED="true"
CORS_ALLOW_ORIGINS="*"
CORS_ALLOW_METHODS="GET,POST,PUT,DELETE,PATCH,OPTIONS"
CORS_ALLOW_HEADERS="Authorization,Content-Type,X-Requested-With,X-Trace-Id"
CORS_EXPOSE_HEADERS="X-Trace-Id"
CORS_ALLOW_CREDENTIALS="false"
CORS_MAX_AGE="86400"

# ---------- 限流（令牌桶） ----------
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_RATE="10"
RATE_LIMIT_BURST="30"
RATE_LIMIT_BY_USER="true"
RATE_LIMIT_BY_IP="true"
# 逗号分隔的精确 IP 白名单（不支持 CIDR）
RATE_LIMIT_WHITELIST=""

# ---------- 云上路由表示例（k8s Service DNS，同 namespace 可省略端口） ----------
# user-service:8085（注册/登录公开）
ROUTE_0="/api/v1/auth|http://user-service:8085|false"
# content-service:8082
ROUTE_1="/api/v1/projects|http://content-service:8082|true"
ROUTE_2="/api/v1/project-services|http://content-service:8082|true"
# sandbox-service:8089（用户面 + 管理面）
ROUTE_3="/api/v1/sandboxes|http://sandbox-service:8089|true"
ROUTE_4="/api/admin/v1/sandboxes|http://sandbox-service:8089|true"
ROUTE_5="/api/admin/v1/anomalies|http://sandbox-service:8089|true"
# training-service:8086
ROUTE_6="/api/v1/ai|http://training-service:8086|true"
ROUTE_7="/api/v1/training|http://training-service:8086|true"
ROUTE_8="/api/v1/admin/pitfalls|http://content-service:8082|true"
ROUTE_9="/api/v1/scoring|http://training-service:8086|true"
ROUTE_10="/api/v1/difficulties|http://training-service:8086|true"
ROUTE_11="/api/v1/alerts|http://training-service:8086|true"
ROUTE_12="/api/v1/metrics|http://training-service:8086|true"
ROUTE_13="/api/v1/logs|http://training-service:8086|true"
ROUTE_14="/api/v1/logviewer|http://training-service:8086|true"
ROUTE_15="/api/v1/health|http://training-service:8086|true"
ROUTE_16="/api/v1/ab-stats|http://training-service:8086|true"
ROUTE_17="/api/v1/recovery|http://training-service:8086|true"
# fault-engine:8088
ROUTE_18="/api/admin/v1/defects|http://content-service:8082|true"
# review-service:8087
ROUTE_19="/api/v1/reviews|http://review-service:8087|true"
# user-service:8085 个人中心（当前用户信息，需登录）
ROUTE_20="/api/v1/users|http://user-service:8085|true"
# review-service:8087 埋点分析（事件/漏斗/看板，需登录）
ROUTE_21="/api/v1/events|http://review-service:8087|true"
ROUTE_22="/api/v1/funnels|http://review-service:8087|true"
ROUTE_23="/api/v1/dashboard|http://review-service:8087|true"
ROUTE_24="/api/v1/ai-behavior|http://review-service:8087|true"
ROUTE_25="/api/v1/ai-board|http://review-service:8087|true"
# 注：/api/v1/events/publish|stats 已并入 api-gateway 本进程（EventHandler +
# X-Internal-API-Key），不经过代理；/ws 为 WebSocket 直连接口，同样无需路由。
