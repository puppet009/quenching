# 统一行尾：仓库内一律 LF，保证 Linux 服务器构建时 shell/Dockerfile 可执行。
* text=auto eol=lf

# 必须 LF 的可执行/构建脚本
*.sh        text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.tpl       text eol=lf
*.go        text eol=lf
*.py        text eol=lf
Makefile    text eol=lf

# 二进制资源不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.gz binary
*.tgz binary
